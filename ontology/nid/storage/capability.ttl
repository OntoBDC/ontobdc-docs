@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix function: <http://w3id.org/function/ontology#> .
@prefix ontobdc: <http://ontobdc.org/ontology/nid/domain.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://ontobdc.org/ontology/nid/storage/capability.ttl#> .

<http://ontobdc.org/ontology/nid/storage/capability.ttl> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

###  http://ontobdc.org/ontology/nid/domain.ttl#QueryCapability
ontobdc:QueryCapability rdf:type owl:Class, function:Function .


#################################################################
#    Individuals
#################################################################

###  http://ontobdc.org/ontology/nid/storage/capability.ttl#ExtractTransformRawText
:ExtractTransformRawText rdf:type owl:NamedIndividual ,
                                  ontobdc:QueryCapability ;
                         dcterms:identifier "org.ontobdc.domain.storage.capability.query.extract_transform_raw_text" ;
                         dcterms:title "Extract and Transform Raw Text"@en ;
                         dcterms:description "Extract and transform raw text to knowledge graph."@en ;
                         dcterms:creator "Elias M. P. Junior" ;
                         ontobdc:version "0.1.0" ;
                         ontobdc:tag "resource", "raw text", "knowledge graph" ;
                         function:expects ( :repositoryParam :rawTextPathParam :guardrailSchemaParam :languageModelExtractorParam ) ;
                         function:returns ( :dataResourceOutput ) ;
                         ontobdc:raises :RepositoryNotConfiguredException .

:repositoryParam rdf:type owl:NamedIndividual ,
                          function:Parameter ;
                 function:predicate <org.ontobdc.domain.resource.document.repository.incoming> ;
                 function:required "true"^^xsd:boolean ;
                 dcterms:description "Repository instance (DocumentRepositoryPort)"@en .

:rawTextPathParam rdf:type owl:NamedIndividual ,
                           function:Parameter ;
                  function:predicate <org.ontobdc.domain.resource.document.raw_text_path> ;
                  function:required "true"^^xsd:boolean ;
                  dcterms:description "Raw text path to extract and transform"@en .

:guardrailSchemaParam rdf:type owl:NamedIndividual ,
                               function:Parameter ;
                      function:predicate <org.ontobdc.domain.resource.document.guardrail_schema> ;
                      function:required "true"^^xsd:boolean ;
                      dcterms:description "Guardrail schema to guide and validate the data extraction process"@en .

:languageModelExtractorParam rdf:type owl:NamedIndividual ,
                                      function:Parameter ;
                             function:predicate <org.ontobdc.domain.resource.document.language_model_extractor> ;
                             function:required "true"^^xsd:boolean ;
                             dcterms:description "Language model data extractor instance (LanguageModelDataExtractorPort)"@en .

:dataResourceOutput rdf:type owl:NamedIndividual ,
                             function:Output ;
                    function:predicate <org.ontobdc.domain.resource.document.data_resource> ;
                    dcterms:description "Knowledge graph representation of the PDF content"@en .

:RepositoryNotConfiguredException rdf:type owl:NamedIndividual ,
                                           ontobdc:Exception ;
                                  ontobdc:errorCode "org.ontobdc.domain.resource.document.exception.repository_not_configured" ;
                                  dcterms:description "File repository not configured for capability"@en ;
                                  ontobdc:pythonType "ValueError" .


