@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix function: <http://w3id.org/function/ontology#> .
@prefix ontobdc: <http://ontobdc.org/ontology/nid/domain.ttl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix schema: <http://schema.org/> .
@base <http://ontobdc.org/ontology/nid/storage/capability.ttl#> .

<http://ontobdc.org/ontology/nid/storage/capability.ttl> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

###  http://ontobdc.org/ontology/nid/domain.ttl#QueryCapability
ontobdc:QueryCapability rdf:type owl:Class ;rdfs:subClassOf function:Function .


#################################################################
#    Individuals
#################################################################

###  http://ontobdc.org/ontology/nid/storage/capability.ttl#ExtractTransformRawText
:ExtractTransformRawText rdf:type owl:NamedIndividual ,
                                  ontobdc:QueryCapability ;
                         dcterms:identifier "org.ontobdc.domain.storage.capability.query.extract_transform_raw_text" ;
                         dcterms:title "Extract and Transform Raw Text"@en ;
                         dcterms:description "Extract and transform raw text to knowledge graph."@en ;
                         dcterms:creator <http://kb.elias.eng.br/nid/elias.ttl#Elias> ;
                         owl:versionInfo "0.1.0" ;
    schema:programmingLanguage "Python" ;

    schema:runtimePlatform "OntoBDC CLI" ;
                         dcat:keyword "resource", "raw text", "knowledge graph" ;
                         function:expects (
                             [ rdf:type :RepositoryParameter ; function:required "true"^^xsd:boolean ]
                             [ rdf:type :RawTextPathParameter ; function:required "true"^^xsd:boolean ]
                             [ rdf:type :GuardrailSchemaParameter ; function:required "true"^^xsd:boolean ]
                             [ rdf:type :LanguageModelExtractorParameter ; function:required "true"^^xsd:boolean ]
                         ) ;
                         function:returns (
                             [ rdf:type ontobdc:QueryResponse ; dcterms:hasPart [ rdf:type :DataResourceGraph ] ]
                         ) ;
                         ontobdc:raises [ rdf:type ontobdc:RepositoryNotConfiguredException] .

:RepositoryParameter rdf:type owl:Class ;
                     rdfs:subClassOf function:Parameter ;
                     dcterms:identifier "org.ontobdc.domain.resource.document.repository.incoming" ;
                     dcterms:description "Repository instance (DocumentRepositoryPort)"@en .

:RawTextPathParameter rdf:type owl:Class ;
                      rdfs:subClassOf function:Parameter ;
                      dcterms:identifier "org.ontobdc.domain.resource.document.raw_text_path" ;
                      dcterms:description "Raw text path to extract and transform"@en .

:GuardrailSchemaParameter rdf:type owl:Class ;
                          rdfs:subClassOf function:Parameter ;
                          dcterms:identifier "org.ontobdc.domain.resource.document.guardrail_schema" ;
                          dcterms:description "Guardrail schema to guide and validate the data extraction process"@en .

:LanguageModelExtractorParameter rdf:type owl:Class ;
                                 rdfs:subClassOf function:Parameter ;
                                 dcterms:identifier "org.ontobdc.domain.resource.document.language_model_extractor" ;
                                 dcterms:description "Language model data extractor instance (LanguageModelDataExtractorPort)"@en .

:DataResourceGraph rdf:type owl:Class ;
                    rdfs:subClassOf function:Output ;
                    dcterms:identifier "org.ontobdc.domain.resource.document.data_resource" ;
                    dcterms:description "Knowledge graph representation of the PDF content"@en .


