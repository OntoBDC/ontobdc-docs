@prefix : <http://ontobdc.org/ontology/nid/domain.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms#> .
@prefix ontouml: <http://w3id.org/ontouml#> .
@prefix schema: <http://schema.org/> .
@prefix err: <http://www.w3.org/2010/02/rdfa/errors#> .
@prefix function: <http://w3id.org/function/ontology#> .
@base <http://ontobdc.org/ontology/nid/domain.ttl#> .

<http://ontobdc.org/ontology/nid/domain.ttl> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms#description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms#identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms#isPartOf
dcterms:isPartOf rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms#title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://w3id.org/function/ontology#returns
function:returns rdf:type owl:AnnotationProperty .


###  http://w3id.org/function/ontology#type
function:type rdf:type owl:AnnotationProperty .


###  http://w3id.org/ontouml#containsModelElement
ontouml:containsModelElement rdf:type owl:AnnotationProperty .


###  http://w3id.org/ontouml#model
ontouml:model rdf:type owl:AnnotationProperty .


###  http://w3id.org/ontouml#name
ontouml:name rdf:type owl:AnnotationProperty .


###  http://w3id.org/ontouml#project
ontouml:project rdf:type owl:AnnotationProperty ;
                rdfs:comment "The result produced by executing the query."@en ;
                rdfs:label "Query response container."@en .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://ontobdc.org/ontology/nid/domain.ttl#QueryCapability
:QueryCapability rdf:type owl:Class ;rdfs:subClassOf function:Function, schema:SoftwareSourceCode ;
                 function:returns :QueryResponse ;
                 ontouml:name "Query capability"@en ;
                 rdfs:comment "Executes a query over a declared data or semantic context."@en .


###  http://ontobdc.org/ontology/nid/domain.ttl#QueryResponse
:QueryResponse rdf:type owl:Class ;rdfs:subClassOf function:Output ;
               ontouml:name "Query response"@en ;
               rdfs:comment "The result produced by executing the query."@en .


###  http://w3id.org/function/ontology#Function
function:Function rdf:type owl:Class .


###  http://w3id.org/ontouml#Package
ontouml:Package rdf:type owl:Class .


###  http://w3id.org/ontouml#Project
ontouml:Project rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://ontobdc.org/ontology/nid/domain.ttl#CapabilityPackage
:CapabilityPackage rdf:type owl:NamedIndividual ,
                            ontouml:Package ;
                   ontouml:containsModelElement :QueryPackage ;
                   ontouml:name "Capability"@en ;
                   ontouml:project :OntoBDC ;
                   skos:notation "capability" .


###  http://ontobdc.org/ontology/nid/domain.ttl#DomainRootPackage
:DomainRootPackage rdf:type owl:NamedIndividual ,
                            ontouml:Package ;
                   ontouml:containsModelElement :StoragePackage ;
                   ontouml:name "Domain Root Package"@en ;
                   ontouml:project :OntoBDC ;
                   skos:notation "domain" .


###  http://ontobdc.org/ontology/nid/domain.ttl#OntoBDC
:OntoBDC rdf:type owl:NamedIndividual ,
                  ontouml:Project ;
         ontouml:model :DomainRootPackage ;
         ontouml:name "OntoBDC Project"@en .


###  http://ontobdc.org/ontology/nid/domain.ttl#QueryPackage
:QueryPackage rdf:type owl:NamedIndividual ,
                       ontouml:Package ;
              ontouml:name "Query"@en ;
              ontouml:project :OntoBDC ;
              skos:notation "query" .


###  http://ontobdc.org/ontology/nid/domain.ttl#StoragePackage
:StoragePackage rdf:type owl:NamedIndividual ,
                         ontouml:Package ;
                dcterms:isPartOf :DomainRootPackage ;
                ontouml:containsModelElement :CapabilityPackage ;
                ontouml:name "Storage"@en ;
                ontouml:project :OntoBDC ;
                skos:notation "storage" .

:Exception rdf:type owl:Class ;
          rdfs:subClassOf err:Error ;
          rdfs:comment "Base exception for all exceptions in the OntoBDC domain."@en .





:RepositoryNotConfiguredException rdf:type owl:Class ;
                                           rdfs:subClassOf :Exception ;
                                  dcterms:identifier "org.ontobdc.domain.resource.document.exception.repository_not_configured" ;
                                  dcterms:description "File repository not configured for capability"@en ;
                                  :pythonType "ValueError" .


:pythonType rdf:type owl:AnnotationProperty .
