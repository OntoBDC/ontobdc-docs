
@prefix : <http://ontobdc.org/ontology/social/shp.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix cv: <http://rdfs.org/resume-rdf/cv.rdfs#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <http://ontobdc.org/ontology/social/shp.ttl#> .

<http://ontobdc.org/ontology/social/shp.ttl> rdf:type owl:Ontology .

:JobOfferShape a sh:NodeShape ;
  sh:targetClass cv:JobOffer ;
  sh:property [
    sh:path cv:title ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:description ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype rdf:langString ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:inLanguage ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:hiringOrganization ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:location ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:employmentType ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:jobLocationType ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:skills ;
    sh:items {"type": "string"},
    "multiLanguage": True,
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:activities ;
    sh:items {"type": "string"},
    "multiLanguage": True,
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path cv:requirements_indispensable ;
    sh:items {"type": "string"},
    "multiLanguage": True,
    sh:maxCount 1 ;
  ] ;

JOB_SCHEMA: Dict[str, Any] = {
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{2,127}$",
            "semantic": {
                "type": "datatype",
                "uri": SCHEMA["name"],
            },
        },
        "title": {
            "type": "string",
            "minLength": 1,
            "multiLanguage": True,
            "semantic": {"type": "datatype", "uri": SCHEMA["title"]},
        },
        "inLanguage": {
            "type": "string",
            "enum": ["pt-br", "en", "es", "fr"],
            "semantic": {"type": "datatype", "uri": SCHEMA["inLanguage"]},
        },
        "hiringOrganization": {
            "type": "string",
            "semantic": {"type": "organization_node", "uri": SCHEMA["hiringOrganization"]},
        },
        "location": {
            "type": "string",
            "semantic": {"type": "datatype", "uri": SCHEMA["jobLocation"]},
        },
        "employmentType": {
            "type": "string",
            "enum": ["full-time", "contract", "internship", "part-time", "seasonal", "temporary"],
            "semantic": {"type": "datatype", "uri": SCHEMA["employmentType"]},
        },
        "jobLocationType": {
            "type": "string",
            "enum": ["hybrid", "remote", "onsite", "synchronous", "asynchronous", "unknown"],
            "semantic": {"type": "datatype", "uri": SCHEMA["jobLocationType"]},
        },
        "skills": {
            "type": "array",
            "items": {"type": "string"},
            "multiLanguage": True,
            "semantic": {"type": "datatype", "uri": SCHEMA["skills"]},
        },
        "activities": {
            "type": "array",
            "items": {"type": "string"},
            "multiLanguage": True,
            "semantic": {"type": "datatype", "uri": SCHEMA["responsibilities"]},
        },
        "requirements_indispensable": {
            "type": "array",
            "items": {"type": "string"},
            "multiLanguage": True,
            "semantic": {"type": "datatype", "uri": BDC_JOB["MandatoryRequirement"]},
        },
        "requirements_desirable": {
            "type": "array",
            "items": {"type": "string"},
            "multiLanguage": True,
            "semantic": {"type": "datatype", "uri": BDC_JOB["DesirableRequirement"]},
        },
    },
    "required": [
        "name",
        "title",
        "inLanguage",
        "hiringOrganization",
        "location",
        "employmentType",
        "jobLocationType",
        "skills",
        "activities",
        "requirements_indispensable",
        "requirements_desirable",
    ],
    "additionalProperties": False,
}