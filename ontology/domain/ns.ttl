@prefix : <http://ontobdc.org/ontology/domain/ns.ttl#> .
@prefix err: <http://www.w3.org/2010/02/rdfa/errors#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ontouml: <http://w3id.org/ontouml#> .
@prefix function: <http://w3id.org/function/ontology#> .
@prefix ct: <http://standards.iso.org/iso/21597/-1/ed-1/en/Container#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@base <http://ontobdc.org/ontology/domain/ns.ttl#> .

<http://ontobdc.org/ontology/domain/ns.ttl> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://w3id.org/ontouml#name
ontouml:name rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .

###  http://ontobdc.org/ontology/domain/ns.ttl#pythonType
:pythonType rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################


###  http://ontobdc.org/ontology/domain/ns.ttl#QueryCapability
:QueryCapability rdf:type owl:Class ;
                 rdfs:subClassOf schema:SoftwareApplication ,
                                 function:Function ;
                 ontouml:name "Query capability"@en ;
                 rdfs:comment "Executes a query over a declared data or semantic context."@en ;
                 function:returns :QueryResponse .

:TransformationCapability rdf:type owl:Class ;
                 rdfs:subClassOf schema:SoftwareApplication ,
                                 function:Function ;
                 ontouml:name "Transformation capability"@en ;
                 rdfs:comment "Executes a transformation over a declared data or semantic context."@en ;
                 function:returns :TransformationResponse .

:TransformationResponse rdf:type owl:Class ;
               rdfs:subClassOf function:Output ;
               ontouml:name "Transformation response"@en ;
               rdfs:comment "The result produced by executing the transformation."@en .

###  http://ontobdc.org/ontology/domain/ns.ttl#TransformableDataPackage
:TransformableDataPackage rdf:type owl:Class ;
                rdfs:subClassOf function:Parameter ;
                ontouml:name "Transformable data package"@en ;
                rdfs:comment "A data package that can be transformed by a TransformationCapability."@en .

###  http://ontobdc.org/ontology/domain/ns.ttl#TransformableDataShape
:TransformableDataShape rdf:type owl:Class ;
                rdfs:subClassOf function:Parameter ;
                ontouml:name "Transformable data shape"@en ;
                rdfs:comment "A shape URI or shape resource used to constrain or guide a transformation capability."@en .

###  http://ontobdc.org/ontology/domain/ns.ttl#StateEvaluator
:StateEvaluator rdf:type owl:Class ;
                rdfs:subClassOf schema:SoftwareApplication ;
                ontouml:name "State evaluator"@en ;
                rdfs:comment "A component that evaluates or determines the state used by a transformation."@en .

###  http://ontobdc.org/ontology/domain/ns.ttl#resultingState
:hasResultingState rdf:type owl:ObjectProperty ;
                rdfs:domain :TransformationResponse ;
                rdfs:range :ResultingState ;
                rdfs:comment "The resulting state of a transformation execution."@en .

###  http://ontobdc.org/ontology/domain/ns.ttl#EtlProcessState
:EtlProcessState rdf:type owl:Class ;
                 rdfs:subClassOf :ResultingState ;
                 ontouml:name "ETL process state"@en ;
                 rdfs:comment "An ETL process lifecycle state."@en .

###  http://ontobdc.org/ontology/domain/ns.ttl#QueryResponse
:QueryResponse rdf:type owl:Class ;
               rdfs:subClassOf function:Output ;
               ontouml:name "Query response"@en ;
               rdfs:comment "The result produced by executing the query."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#ResultingState
:ResultingState rdf:type owl:Class ;
                rdfs:subClassOf schema:actionStatus, function:Output ;
                ontouml:name "Resulting state"@en ;
                rdfs:comment "The state of the repository after the query execution."@en .


###  http://schema.org/SoftwareSourceCode
schema:SoftwareSourceCode rdf:type owl:Class .


###  http://schema.org/actionStatus
schema:actionStatus rdf:type owl:Class .


###  http://w3id.org/function/ontology#Function
function:Function rdf:type owl:Class .


###  http://w3id.org/function/ontology#Output
function:Output rdf:type owl:Class .


###  http://www.w3.org/2010/02/rdfa/errors#Error
err:Error rdf:type owl:Class .

###  http://ontobdc.org/ontology/domain/ns.ttl#ExecutionContext
:ExecutionContext rdf:type owl:Class ;
                  ontouml:name "Execution context"@en ;
                  rdfs:comment "The execution context that stores runtime parameters for a CLI interaction."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#contextLanguage
:contextLanguage rdf:type owl:DatatypeProperty ;
                 rdfs:domain :ExecutionContext ;
                 rdfs:range xsd:string ;
                 ontouml:name "Context language"@en ;
                 rdfs:comment "The language selected for the current execution context."@en ;
                 :pythonType "context_language" .


###  http://ontobdc.org/ontology/domain/ns.ttl#userIntent
:userIntent rdf:type owl:DatatypeProperty ;
            rdfs:domain :ExecutionContext ;
            rdfs:range xsd:string ;
            ontouml:name "User intent"@en ;
            rdfs:comment "The raw intent text provided by the user in the current execution context."@en ;
            :pythonType "user_intent" .


###  http://ontobdc.org/ontology/domain/ns.ttl#parsedIntent
:parsedIntent rdf:type owl:ObjectProperty ;
              rdfs:domain :ExecutionContext ;
              rdfs:range function:Output ;
              ontouml:name "Parsed intent"@en ;
              rdfs:comment "The structured interpretation of the user intent generated during execution."@en ;
              :pythonType "parsed_intent" .


###  http://ontobdc.org/ontology/domain/ns.ttl#capabilityId
:capabilityId rdf:type owl:DatatypeProperty ;
              rdfs:domain :ExecutionContext ;
              rdfs:range xsd:string ;
              ontouml:name "Capability identifier"@en ;
              rdfs:comment "The identifier of the capability selected for the current execution context."@en ;
              :pythonType "capability_id" .


:datasetId rdf:type owl:ObjectProperty ;
                        rdfs:domain :ExecutionContext ;
                        rdfs:range :IncomingDatasetParameter ;
                        ontouml:name "Dataset identifier"@en ;
                        rdfs:comment "The identifier of the dataset repository instance to use for the current execution context."@en .


###  http://ontobdc.org/ontology/domain/ns.ttl#IncomingDatasetParameter
:IncomingDatasetParameter rdf:type owl:Class ;
                         rdfs:subClassOf function:Parameter ;
                         dcterms:identifier "org.ontobdc.domain.storage.capability.incoming.dataset" ;
                         ontouml:name "Incoming Dataset"@en ;
                         rdfs:comment "Dataset repository instance"@en .

:OutputSchema rdf:type owl:Class ;
               rdfs:subClassOf function:Output ;
               dcterms:identifier "ooutput_schema" ;
               ontouml:name "Output schema"@en ;
               rdfs:comment "The schema of the output data produced by the query execution."@en .

:outputContains rdf:type owl:ObjectProperty ;
               rdfs:domain :QueryCapability ;
               rdfs:range :outputSchema ;
               ontouml:name "Output contains"@en ;
               rdfs:comment "The output schema contains the specified field."@en .

:DataStorage rdf:type owl:Class ;
               rdfs:subClassOf dcat:DataService , function:Function ;
               ontouml:name "Data storage"@en ;
               rdfs:comment "The data storage capability that manages data containers and semantic storage."@en .

:hasDataContainer rdf:type owl:ObjectProperty ;
               rdfs:domain :DataStorage ;
               rdfs:range :DataContainer ;
               ontouml:name "Has data container"@en ;
               rdfs:comment "The data storage capability has the specified data container."@en .

:DataContainer rdf:type owl:Class ;
               rdfs:subClassOf ct:ContainerDescription, dcat:Catalog ;
               ontouml:name "Data container"@en ;
               rdfs:comment "A catalog or container that groups and organizes entity datasets."@en .

:hasEntityDataset rdf:type owl:ObjectProperty ;
                 rdfs:inverseProperty :belongsToDataContainer ;
                 rdfs:subPropertyOf dcterms:hasPart ;
               rdfs:domain :DataContainer ;
               rdfs:range :EntityDataset ;
               ontouml:name "Has entity dataset"@en ;
               rdfs:comment "The data container has the specified entity dataset."@en .

:belongsToDataContainer rdf:type owl:ObjectProperty ;
                 rdfs:inverseProperty :hasEntityDataset ;
                 rdfs:subPropertyOf dcterms:isPartOf ;
               rdfs:domain :EntityDataset ;
               rdfs:range :DataContainer ;
               ontouml:name "Belongs to data container"@en ;
               rdfs:comment "The entity dataset belongs to the specified data container."@en .

:hasDataEntity rdf:type owl:ObjectProperty ;
               rdfs:domain :EntityDataset ;
               rdfs:range :dataEntity ;
               rdfs:subPropertyOf prov:hadMember ;
               ontouml:name "Has data entity"@en ;
               rdfs:comment "The dataset contains the specific data entity."@en .

:hasDocumentType rdf:type owl:ObjectProperty ;
               rdfs:domain :DataEntity ;
               rdfs:range :DocumentType ;
               rdfs:subPropertyOf schema:additionalType ;
               ontouml:name "Has document type"@en ;
               rdfs:comment "Relates a data entity to its document type classification."@en .

:isEntityOf rdf:type owl:ObjectProperty ;
               rdfs:domain :DataEntity ;
               rdfs:range :DataEntity ;
               rdfs:subPropertyOf schema:additionalType ;
               owl:inverseOf :hasEntity ;
               ontouml:name "Is entity of"@en ;
               rdfs:comment "Relates a data entity to the entity that classifies it."@en .

:hasEntity rdf:type owl:ObjectProperty ;
               rdfs:domain :DataEntity ;
               rdfs:range :DataEntity ;
               owl:inverseOf :isEntityOf ;
               ontouml:name "Has entity"@en ;
               rdfs:comment "Relates an entity classification to the data entities classified by it."@en .

:isDocumentEntityTypeOf rdf:type owl:ObjectProperty ;
               rdfs:domain :DocumentType ;
               rdfs:range :DataEntity ;
               ontouml:name "Has productivity entity"@en ;
               rdfs:comment "Relates a document type to the productivity entity that should classify published data entities."@en .

:documentTypeVectorValue rdf:type owl:DatatypeProperty ;
               rdfs:domain :DocumentType ;
               rdfs:range xsd:string ;
               rdfs:subPropertyOf schema:value ;
               ontouml:name "Document type vector value"@en ;
               rdfs:comment "Serialized vector value used to represent a document type profile."@en .

:EntityDataset rdf:type owl:Class ;
               rdfs:subClassOf dcat:Dataset, ct:Folder ;
               ontouml:name "Entity dataset"@en ;
               rdfs:comment "A dataset representing a collection of related data entities."@en .

:DocumentType rdf:type owl:Class ;
               rdfs:subClassOf :DataEntity, schema:DefinedTerm ;
               ontouml:name "Document type"@en ;
               rdfs:comment "A controlled document type used to classify data entities."@en .

:DataEntity rdf:type owl:Class ;
               rdfs:subClassOf prov:Entity ;
               ontouml:name "Data entity"@en ;
               rdfs:comment "An individual data entity or resource."@en .
