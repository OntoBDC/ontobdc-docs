@prefix : <http://ontobdc.org/ontology/ns/domain.ttl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix function: <http://w3id.org/function/ontology#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix err: <http://www.w3.org/2010/02/rdfa/errors#> .
@prefix ontouml: <http://w3id.org/ontouml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix h: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <http://ontobdc.org/ontology/ns/domain.ttl#> .

<http://ontobdc.org/ontology/ns/domain.ttl> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

###  http://ontobdc.org/ontology/nid/domain.ttl#QueryCapability
:QueryCapability rdf:type owl:Class ;rdfs:subClassOf function:Function, schema:SoftwareSourceCode ;
                 ontouml:name "Query capability"@en ;
                 rdfs:comment "Executes a query over a declared data or semantic context."@en .

:QueryCapabilityShape a sh:NodeShape ;
  sh:targetClass :QueryCapability ;
  sh:property [
    sh:path dcterms:identifier ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:title ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype rdf:langString ]
    ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:description ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype rdf:langString ]
    ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcterms:creator ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:nodeKind sh:BlankNodeOrIRI ]
    ) ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path dcat:keyword ;
    sh:or (
      [ sh:datatype xsd:string ]
      [ sh:datatype rdf:langString ]
    ) ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path function:expects ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:hasValue rdf:nil ]
      [ sh:nodeKind sh:BlankNodeOrIRI ]
    ) ;
    sh:node [
      sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [
          sh:property [
            sh:path rdf:type ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
          ] ;
          sh:property [
            sh:path function:required ;
            sh:datatype xsd:boolean ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
          ] ;
        ] ;
      ] ;
    ] ;
  ] ;
  sh:property [
    sh:path function:returns ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:hasValue rdf:nil ]
      [ sh:nodeKind sh:BlankNodeOrIRI ]
    ) ;
    sh:node [
      sh:property [
        sh:path ( [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:node [
          sh:property [
            sh:path rdf:type ;
            sh:hasValue :QueryResponse ;
            sh:minCount 1 ;
          ] ;
          sh:property [
            sh:path dcterms:hasPart ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:maxCount 1 ;
            sh:node [
              sh:property [
                sh:path rdf:type ;
                sh:nodeKind sh:IRI ;
                sh:minCount 1 ;
              ] ;
            ] ;
          ] ;
        ] ;
      ] ;
    ] ;
  ] ;
  sh:property [
    sh:path :raises ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:node [
      sh:property [
        sh:path rdf:type ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
      ] ;
    ] ;
  ] ;
  sh:property [
    sh:path schema:programmingLanguage ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path schema:runtimePlatform ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path owl:versionInfo ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] .


###  http://ontobdc.org/ontology/nid/domain.ttl#QueryResponse
:QueryResponse rdf:type owl:Class ;rdfs:subClassOf function:Output ;
               ontouml:name "Query response"@en ;
               rdfs:comment "The result produced by executing the query."@en .

:Exception rdf:type owl:Class ;
          rdfs:subClassOf err:Error ;
          rdfs:comment "Base exception for all exceptions in the OntoBDC domain."@en .

:RepositoryNotConfiguredException rdf:type owl:Class ;
                                           rdfs:subClassOf :Exception ;
                                  dcterms:identifier "org.ontobdc.domain.resource.document.exception.repository_not_configured" ;
                                  dcterms:description "File repository not configured for capability"@en ;
                                  :pythonType "ValueError" .
